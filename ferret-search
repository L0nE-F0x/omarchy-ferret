#!/usr/bin/python3
"""Ferret's search backend: whole-disk file lookup, ranked for humans.

Two sources feed one ranked list:

  plocate  indexed, whole disk, ~20ms, but only as fresh as last night's
           updatedb run.
  fd       live walk of $HOME, ~100ms warm, so files made since the last
           index still show up.

Merged, deduped, and scored so the thing you meant is first. Called per
keystroke by the Ferret overlay; also usable on its own:

    ferret-search -- "budget xlsx"     # JSON results on stdout
    ferret-search --open <path>        # hand the path to its default app
    ferret-search --reveal <path>      # open the containing folder

Helpers are resolved from trusted directories by absolute path and executed
as that same path. Ambient PATH is never consulted. Search children live in
their own process groups, have a hard stdout cap, and are killed on cancel
or deadline.
"""

import fcntl
import json
import os
import re
import select
import signal
import stat
import subprocess
import sys
import threading
import time
from concurrent.futures import ThreadPoolExecutor

HOME = os.path.expanduser("~")

# How many raw paths each source may return before scoring. Generous: the
# ranker is cheap and a hard cap here is what makes a common word like
# "config" still surface the *right* config.
SOURCE_LIMIT = 6000
# How many survive to the UI.
RESULT_LIMIT = 60
# Only the top slice gets stat()ed for recency scoring -- stat is the one
# genuinely expensive call in here.
STAT_LIMIT = 240

# Producer-side byte caps. A result-count cap does not bound pathname length.
STDOUT_CAP = 1 * 1024 * 1024
JSON_CAP = 1 * 1024 * 1024
SOURCE_TIMEOUT = 4.0
SEARCH_DEADLINE = 10

# Directories searched for helper binaries. Lookups never use ambient PATH.
TRUSTED_BIN_DIRS = ("/usr/bin", "/bin", "/usr/local/bin")
TRUSTED_PATH = "/usr/bin:/bin"

# Directories that are technically matches but almost never what a person
# typing into a launcher wants. Penalised, not excluded: search "node_modules"
# explicitly and you will still find it.
NOISE = (
    ("/node_modules/", 400),
    ("/.git/", 400),
    ("/.cache/", 300),
    ("/site-packages/", 300),
    ("/__pycache__/", 400),
    ("/.venv/", 250),
    ("/venv/", 250),
    ("/.local/share/Trash/", 500),
    ("/.mozilla/", 200),
    ("/.config/google-chrome/", 400),
    ("/indexeddb/", 450),
    ("/local storage/", 450),
    ("/session storage/", 450),
    ("/service worker/", 450),
    ("/cache_data/", 450),
    (".leveldb", 400),
    ("/.steam/", 200),
    ("/usr/lib/", 150),
    ("/usr/share/doc/", 200),
    ("/usr/src/", 200),
    ("/var/lib/", 200),
    ("/proc/", 500),
    ("/sys/", 500),
    ("/snap/", 250),
    ("/.rustup/", 300),
    ("/.cargo/registry/", 300),
    ("/.npm/", 300),
    ("/.gradle/", 300),
    ("/build/", 260),
    ("/_deps/", 400),
    ("/cmake-build", 300),
    ("/target/debug/", 300),
    ("/target/release/", 300),
    ("/dist/", 200),
    ("/.next/", 300),
    ("/vendor/", 200),
    ("/.config/chromium/", 320),
    ("/.config/Code/", 300),
    ("/.local/share/containers/", 300),
    ("/.bak.", 120),
    ("/backup", 120),
    ("/.local/state/", 150),
    ("/google-chrome-headless/", 320),
    ("/.grok/bundled/", 250),
    ("/.claude/projects/", 150),
)

# Where a person actually keeps their stuff.
PRIME = (
    "/Documents/", "/Downloads/", "/Desktop/", "/Pictures/",
    "/Videos/", "/Music/", "/Projects/",
)

_LIVE = []
_LIVE_LOCK = threading.Lock()
BIN = {}


def resolve_bin(name):
    """Return a trusted absolute path for name, or None.

    The returned path is the identity that must be executed: a file inside
    TRUSTED_BIN_DIRS. Symlinks that escape those directories are rejected.
    Names containing a slash are rejected so this cannot be used as a path
    probe.
    """
    if not name or name in (".", "..") or "/" in name:
        return None
    for directory in TRUSTED_BIN_DIRS:
        candidate = os.path.join(directory, name)
        if not os.path.isfile(candidate):
            continue
        if not os.access(candidate, os.X_OK):
            continue
        try:
            real = os.path.realpath(candidate)
        except OSError:
            continue
        if not _is_trusted_path(real):
            continue
        return candidate
    return None


def _is_trusted_path(path):
    try:
        real = os.path.realpath(path)
    except OSError:
        return False
    for directory in TRUSTED_BIN_DIRS:
        try:
            root = os.path.realpath(directory)
        except OSError:
            continue
        if real == root or real.startswith(root + os.sep):
            return True
    return False


def _resolve_bins():
    found = {}
    for name in ("plocate", "fd", "fdfind", "xdg-open", "uwsm-app", "gio"):
        path = resolve_bin(name)
        if path:
            found[name] = path
    if "fd" not in found and "fdfind" in found:
        found["fd"] = found["fdfind"]
    return found


def _child_env():
    env = os.environ.copy()
    env["PATH"] = TRUSTED_PATH
    return env


def _register(proc):
    with _LIVE_LOCK:
        _LIVE.append(proc)


def _unregister(proc):
    with _LIVE_LOCK:
        try:
            _LIVE.remove(proc)
        except ValueError:
            pass


def _kill_group(proc):
    if proc is None or proc.poll() is not None:
        return
    try:
        os.killpg(proc.pid, signal.SIGKILL)
    except OSError:
        try:
            proc.kill()
        except OSError:
            pass


def _kill_all():
    with _LIVE_LOCK:
        procs = list(_LIVE)
    for proc in procs:
        _kill_group(proc)


def _handle_signal(signum, _frame):
    signal.signal(signum, signal.SIG_IGN)
    _kill_all()
    if signum == signal.SIGALRM:
        try:
            sys.stdout.buffer.write(b"[]")
            sys.stdout.buffer.flush()
        except Exception:
            pass
        os._exit(0)
    os._exit(128 + (signum if isinstance(signum, int) else 1))


def _collect_stdout(proc, cap, timeout):
    """Read stdout up to cap bytes. Kill the process group on cap or timeout."""
    deadline = time.monotonic() + timeout
    buf = bytearray()
    fd = proc.stdout.fileno()
    flags = fcntl.fcntl(fd, fcntl.F_GETFL)
    fcntl.fcntl(fd, fcntl.F_SETFL, flags | os.O_NONBLOCK)
    timed_out = False
    truncated = False
    try:
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                timed_out = True
                break
            if len(buf) >= cap:
                truncated = True
                break
            ready, _, _ = select.select([fd], [], [], remaining)
            if not ready:
                timed_out = True
                break
            try:
                chunk = os.read(fd, min(65536, cap - len(buf)))
            except BlockingIOError:
                continue
            if not chunk:
                break
            buf.extend(chunk)
    finally:
        if timed_out or truncated:
            _kill_group(proc)
        try:
            proc.wait(timeout=0.4)
        except subprocess.TimeoutExpired:
            _kill_group(proc)
            try:
                proc.wait(timeout=0.4)
            except subprocess.TimeoutExpired:
                pass
        try:
            proc.stdout.close()
        except OSError:
            pass
    if timed_out and not buf:
        return b""
    if truncated:
        # Drop a trailing partial line so we never emit a cut pathname.
        nl = buf.rfind(b"\n")
        if nl >= 0:
            return bytes(buf[: nl + 1])
        return b""
    return bytes(buf)


def run(cmd, timeout=SOURCE_TIMEOUT):
    """Run an already-resolved absolute command, return its stdout as paths.

    Never raises -- a dead source just means the other one carries the search.
    Trailing slashes are stripped because fd marks directories with one and
    plocate does not: left alone, the same directory arrives as two distinct
    strings, survives deduplication twice, and the slashed copy renders with
    an empty basename.
    """
    if not cmd or not os.path.isabs(cmd[0]):
        return []
    try:
        proc = subprocess.Popen(
            cmd,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
            close_fds=True,
            env=_child_env(),
        )
    except OSError:
        return []
    _register(proc)
    try:
        raw = _collect_stdout(proc, STDOUT_CAP, timeout)
    finally:
        _unregister(proc)
    if not raw:
        return []
    paths = []
    for line in raw.decode("utf-8", errors="replace").splitlines():
        line = line.rstrip("/")
        if line:
            paths.append(line)
    return paths


def locate_source(tokens):
    """plocate with every token ANDed -- its native multi-pattern behaviour."""
    plocate = BIN.get("plocate")
    if not plocate:
        return []
    return run([plocate, "-i", "--limit", str(SOURCE_LIMIT), "--"] + list(tokens))


def locate_fuzzy(tokens):
    """Subsequence fallback: 'invc' -> i.*n.*v.*c, so abbreviations land.

    Only worth spending the ~40ms when the literal search came up thin.
    """
    plocate = BIN.get("plocate")
    if not plocate:
        return []
    longest = max(tokens, key=len)
    if len(longest) < 3:
        return []
    pattern = ".*".join(re.escape(ch) for ch in longest)
    return run([plocate, "-i", "--regexp", "--limit", str(SOURCE_LIMIT), "--", pattern])


def fd_source(tokens):
    """Live walk of $HOME so today's files are findable before tonight's
    updatedb. fd takes one pattern, so filter on the longest token and let
    the scorer handle the rest."""
    fd = BIN.get("fd")
    if not fd:
        return []
    longest = max(tokens, key=len)
    return run([
        fd, "--hidden", "--absolute-path", "--color", "never",
        "--max-results", str(SOURCE_LIMIT),
        "--ignore-case", "--fixed-strings", "--", longest, HOME,
    ])


def subsequence_span(needle, haystack):
    """Length of the tightest run covering needle as a subsequence of
    haystack, or None. Shorter span = tighter, more deliberate match."""
    start = -1
    idx = 0
    for i, ch in enumerate(haystack):
        if idx < len(needle) and ch == needle[idx]:
            if idx == 0:
                start = i
            idx += 1
            if idx == len(needle):
                return i - start + 1
    return None


def score(path, tokens, query):
    """Rank a candidate. Positive is better; callers sort descending."""
    lower = path.lower()
    name = os.path.basename(path)
    lname = name.lower()

    # Every token must appear somewhere in the path, or it is not a hit.
    if not all(tok in lower for tok in tokens):
        # Allow a pure subsequence hit on the basename (abbreviation typing).
        span = subsequence_span(query.replace(" ", ""), lname)
        if span is None:
            return None
        points = 40 - min(30, span - len(query))
    else:
        points = 0
        in_name = [tok for tok in tokens if tok in lname]

        if len(tokens) == 1 and lname.endswith("." + query):
            points += 150

        if lname == query:
            points += 260
        elif os.path.splitext(lname)[0] == query:
            points += 240
        elif len(in_name) == len(tokens):
            points += 120
            if lname.startswith(tokens[0]):
                points += 70
            # Match on a word boundary reads as intentional.
            if re.search(r"(^|[^a-z0-9])" + re.escape(tokens[0]), lname):
                points += 30
        elif in_name:
            points += 60
        else:
            points += 15  # matched only in the directory part

    # Prefer the user's own files over the system's, strongly.
    if lower.startswith(HOME.lower() + "/"):
        points += 90
        if any(p.lower() in lower for p in PRIME):
            points += 45
    elif lower.startswith("/etc/"):
        points += 20

    for fragment, cost in NOISE:
        if fragment.lower() in lower:
            points -= cost

    # Hidden components are usually config plumbing, not documents.
    points -= 9 * sum(1 for part in path.split("/")[1:] if part.startswith("."))
    # Shallow beats deep; short names beat long ones.
    points -= 3 * path.count("/")
    points -= 0.35 * len(name)
    return points


def enrich(paths, tokens, query):
    """Score, take the best, then stat only those for recency and type."""
    scored = []
    for path in paths:
        points = score(path, tokens, query)
        if points is not None:
            scored.append((points, path))
    scored.sort(key=lambda item: (-item[0], len(item[1])))

    results = []
    now = time.time()
    for points, path in scored[:STAT_LIMIT]:
        try:
            st = os.stat(path)
        except OSError:
            continue  # indexed but gone since -- silently drop
        is_dir = os.path.isdir(path)
        age_days = (now - st.st_mtime) / 86400
        if age_days < 7:
            points += 34
        elif age_days < 30:
            points += 18
        elif age_days < 365:
            points += 6
        results.append({
            "path": path,
            "name": os.path.basename(path),
            "dir": os.path.dirname(path),
            "isDir": is_dir,
            "ext": "" if is_dir else os.path.splitext(path)[1].lstrip(".").lower(),
            "size": 0 if is_dir else st.st_size,
            "mtime": int(st.st_mtime),
            "score": round(points, 2),
        })

    results.sort(key=lambda item: -item["score"])
    return results[:RESULT_LIMIT]


def search(query):
    query = " ".join(query.lower().split())
    if len(query) < 2:
        return []
    tokens = query.split()

    with ThreadPoolExecutor(max_workers=2) as pool:
        a = pool.submit(locate_source, tokens)
        b = pool.submit(fd_source, tokens)
        paths = set(a.result()) | set(b.result())

    results = enrich(paths, tokens, query)
    # Thin literal result set: retry as an abbreviation before giving up.
    if len(results) < 5:
        paths |= set(locate_fuzzy(tokens))
        results = enrich(paths, tokens, query)
    return results


def _valid_desktop(path):
    if not path or not os.path.isabs(path) or not path.endswith(".desktop"):
        return False
    try:
        st = os.stat(path)
    except OSError:
        return False
    if not stat.S_ISREG(st.st_mode):
        return False
    return os.access(path, os.R_OK)


def _gio_default_app(path):
    """Return (AppInfo, Gio.File) for path's content type, or (None, None)."""
    try:
        from gi.repository import Gio
    except ImportError:
        return None, None
    gfile = Gio.File.new_for_path(path)
    try:
        info = gfile.query_info(
            "standard::content-type", Gio.FileQueryInfoFlags.NONE, None,
        )
        mime = info.get_content_type()
    except Exception:
        return None, gfile
    if not mime:
        return None, gfile
    try:
        app = Gio.AppInfo.get_default_for_type(mime, False)
    except Exception:
        return None, gfile
    return app, gfile


def _desktop_filename(app):
    if app is None:
        return ""
    try:
        name = app.get_filename()
    except Exception:
        return ""
    return name if _valid_desktop(name) else ""


def _spawn_detached(argv):
    """Start a session-leader child from a trusted absolute argv[0]."""
    if not argv or not os.path.isabs(argv[0]):
        return False
    try:
        subprocess.Popen(
            argv,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
            close_fds=True,
            env=_child_env(),
        )
        return True
    except OSError:
        return False


def launch(path):
    """Open a path in the app that owns it.

    The default handler is resolved through GIO (alias-aware mime lookup).
    The desktop file path GIO returns is validated, then handed to uwsm-app
    as a file path — never as a desktop-id argv[0]. If uwsm-app is missing,
    GIO's AppInfo.launch is used. xdg-open is the last resort.
    """
    path = os.path.abspath(path)
    if not os.path.exists(path):
        return 1

    app, gfile = _gio_default_app(path)
    desktop = _desktop_filename(app)
    uwsm = BIN.get("uwsm-app")
    gio = BIN.get("gio")

    if desktop and uwsm:
        if _spawn_detached([uwsm, "--", desktop, path]):
            return 0
    if desktop and gio:
        if _spawn_detached([gio, "launch", desktop, path]):
            return 0
    if app is not None and gfile is not None:
        try:
            if app.launch([gfile], None):
                return 0
        except Exception:
            pass

    xdg = BIN.get("xdg-open")
    if xdg and _spawn_detached([xdg, path]):
        return 0
    return 1


def emit_json(results):
    while True:
        payload = json.dumps(
            results, ensure_ascii=False, separators=(",", ":"),
        ).encode("utf-8")
        if len(payload) <= JSON_CAP:
            sys.stdout.buffer.write(payload)
            sys.stdout.buffer.flush()
            return 0
        if not results:
            sys.stdout.buffer.write(b"[]")
            sys.stdout.buffer.flush()
            return 0
        results = results[:-1]


def main():
    args = sys.argv[1:]
    if args and args[0] == "--":
        args = args[1:]
    if not args:
        sys.stdout.buffer.write(b"[]")
        return 0
    if args[0] == "--open":
        return launch(args[1] if len(args) > 1 else "")
    if args[0] == "--reveal":
        target = args[1] if len(args) > 1 else ""
        if not target:
            return 1
        return launch(target if os.path.isdir(target) else os.path.dirname(target))

    signal.signal(signal.SIGALRM, _handle_signal)
    signal.alarm(int(SEARCH_DEADLINE))
    return emit_json(search(" ".join(args)))


if __name__ == "__main__":
    signal.signal(signal.SIGTERM, _handle_signal)
    signal.signal(signal.SIGINT, _handle_signal)
    signal.signal(signal.SIGHUP, _handle_signal)
    BIN.update(_resolve_bins())
    sys.exit(main())
else:
    BIN.update(_resolve_bins())
